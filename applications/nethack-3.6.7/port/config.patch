+#define NH_LEVEL_MAX (MAXDUNGEON * MAXLEVEL + 1)
+
+static void nh_checkpoint_io(int fd, void *buf, size_t n, int writing)
+{
+    unsigned char *p = buf;
+    while (n) {
+        int got = writing ? write(fd, p, n) : read(fd, p, n);
+        if (got <= 0)
+            panic(writing ? "cannot write checkpoint manifest"
+                          : "truncated checkpoint manifest");
+        p += got;
+        n -= got;
+    }
+}
+
+static uint32_t nh_checkpoint_crc(int fd, uint32_t *size)
+{
+    unsigned char buf[256];
+    uint32_t crc = UINT32_MAX;
+    int got, j;
+    *size = 0;
+    while ((got = read(fd, buf, sizeof buf)) > 0) {
+        int i;
+        if ((uint32_t) got > UINT32_MAX - *size) {
+            (void) nhclose(fd);
+            panic("checkpoint level too large");
+        }
+        *size += got;
+        for (i = 0; i < got; ++i) {
+            crc ^= buf[i];
+            for (j = 0; j < 8; ++j)
+                crc = (crc >> 1) ^ (UINT32_C(0xedb88320) & (0U - (crc & 1U)));
+        }
+    }
+    if (got < 0) {
+        (void) nhclose(fd);
+        panic("cannot read checkpoint level");
+    }
+    return ~crc;
+}
+
+void nh_checkpoint_write(int fd, int current)
+{
+    uint32_t magic = UINT32_C(0x4353484e); /* NHSC, little endian */
+    uint16_t count = 0, lev;
+    uint32_t size, crc;
+    int i, cached;
+    for (i = 1; i <= maxledgerno(); ++i)
+        if (i != current && (level_info[i].flags & LFILE_EXISTS)) ++count;
+    nh_checkpoint_io(fd, &magic, sizeof magic, 1);
+    nh_checkpoint_io(fd, &count, sizeof count, 1);
+    for (i = 1; i <= maxledgerno(); ++i) {
+        if (i == current || !(level_info[i].flags & LFILE_EXISTS)) continue;
+        cached = open_levelfile(i, (char *) 0);
+        if (cached < 0) panic("missing checkpoint level %d", i);
+        crc = nh_checkpoint_crc(cached, &size);
+        (void) nhclose(cached);
+        if (!size) panic("empty checkpoint level %d", i);
+        lev = i;
+        nh_checkpoint_io(fd, &lev, sizeof lev, 1);
+        nh_checkpoint_io(fd, &size, sizeof size, 1);
+        nh_checkpoint_io(fd, &crc, sizeof crc, 1);
+    }
+}
+
+void nh_checkpoint_read(int fd, int verify)
+{
+    uint32_t magic, size, crc, actual_size, actual_crc;
+    uint16_t count, lev;
+    unsigned char seen[(NH_LEVEL_MAX + 8) / 8];
+    int i, cached;
+    memset(seen, 0, sizeof seen);
+    nh_checkpoint_io(fd, &magic, sizeof magic, 0);
+    nh_checkpoint_io(fd, &count, sizeof count, 0);
+    if (magic != UINT32_C(0x4353484e) || count > NH_LEVEL_MAX)
+        panic("invalid checkpoint manifest");
+    for (i = 0; i < count; ++i) {
+        nh_checkpoint_io(fd, &lev, sizeof lev, 0);
+        nh_checkpoint_io(fd, &size, sizeof size, 0);
+        nh_checkpoint_io(fd, &crc, sizeof crc, 0);
+        if (!lev || lev > NH_LEVEL_MAX || !size
+            || (seen[lev / 8] & (1U << (lev % 8))))
+            panic("invalid checkpoint level %d", lev);
+        seen[lev / 8] |= 1U << (lev % 8);
+        if (!verify) continue;
+        cached = open_levelfile(lev, (char *) 0);
+        if (cached < 0) panic("missing checkpoint level %d", lev);
+        actual_crc = nh_checkpoint_crc(cached, &actual_size);
+        (void) nhclose(cached);
+        if (actual_size != size || actual_crc != crc)
+            panic("damaged checkpoint level %d", lev);
+    }
+}
+
+/* Cached levels belong to a game, not to the process which resumes it.
+ * Keep that game's original owner for later level reads and writes; updating
+ * only the tiny lock avoids decompressing/rewriting every cached level. */
+void nh_checkpoint_owner(int owner)
+{
+    int fd;
+    if (owner <= 0)
+        panic("invalid checkpoint owner");
+    if (hackpid == owner)
+        return;
+    set_levelfile_name(lock, 0);
+    fd = creat(fqname(lock, LEVELPREFIX, 0), FCMASK);
+    if (fd < 0)
+        panic("cannot update checkpoint owner");
+    nh_checkpoint_io(fd, &owner, sizeof owner, 1);
+    if (nhclose(fd) < 0)
+        panic("cannot close checkpoint owner");
+    hackpid = owner;
+}

+static boolean nhtamp_compressing;
+
+STATIC_OVL void
+nhtamp_cflushout()
+{
+    if (nhtamp_cout_len) {
+        unsigned int n = nhtamp_cout_len;
+
+        nhtamp_cout_len = 0;
+        if ((unsigned int) write(nhtamp_cfd, nhtamp_cout, n) != n)
+            panic("cannot write %u bytes to file #%d", n, nhtamp_cfd);
+    }
+}
+
+STATIC_OVL void
+nhtamp_cput(buf, n)
+const unsigned char *buf;
+size_t n;
+{
+    while (n) {
+        size_t room = sizeof nhtamp_cout - nhtamp_cout_len;
+        size_t k = (n < room) ? n : room;
+
+        memcpy(nhtamp_cout + nhtamp_cout_len, buf, k);
+        nhtamp_cout_len += (unsigned int) k;
+        buf += k;
+        n -= k;
+        if (nhtamp_cout_len == sizeof nhtamp_cout)
+            nhtamp_cflushout();
+    }
+}
+
+STATIC_OVL void
+nhtamp_cfeed(buf, n)
+const unsigned char *buf;
+size_t n;
+{
+    while (n) {
+        unsigned char out[32];
+        size_t written = 0, consumed = 0;
+        tamp_res res = tamp_compressor_compress(&nhtamp_comp, out, sizeof out,
+                                                &written, buf, n, &consumed);
+
+        if (written)
+            nhtamp_cput(out, written);
+        if (consumed == 0 && written == 0)
+            panic("tamp: compression stalled (%d)", (int) res);
+        buf += consumed;
+        n -= consumed;
+        if (res != TAMP_OK && res != TAMP_OUTPUT_FULL
+            && res != TAMP_INPUT_EXHAUSTED)
+            panic("tamp: compression error %d", (int) res);
+    }
+}
+
+/* Append one byte of the RLE stream to the staging buffer, feeding Tamp
+ * whenever it fills. */
+STATIC_OVL void
+nhtamp_emit(c)
+unsigned char c;
+{
+    nhtamp_stage[nhtamp_stage_len++] = c;
+    if (nhtamp_stage_len == sizeof nhtamp_stage) {
+        nhtamp_cfeed(nhtamp_stage, nhtamp_stage_len);
+        nhtamp_stage_len = 0;
+    }
+}
+
+/* Terminate a pending zero run, emitting RLESC and the run count. */
+STATIC_OVL void
+nhtamp_endrun()
+{
+    if (nhtamp_outrun >= 0) {
+        nhtamp_emit((unsigned char) RLESC);
+        nhtamp_emit((unsigned char) nhtamp_outrun);
+        nhtamp_outrun = -1;
+    }
+}
+
+/* Push any staged RLE bytes into Tamp. */
+STATIC_OVL void
+nhtamp_stage_flush()
+{
+    if (nhtamp_stage_len) {
+        nhtamp_cfeed(nhtamp_stage, nhtamp_stage_len);
+        nhtamp_stage_len = 0;
+    }
+}

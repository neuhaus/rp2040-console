+    if (nhtamp_outrun >= 0) {
+        nhtamp_emit((unsigned char) RLESC);
+        nhtamp_emit((unsigned char) nhtamp_outrun);
+        nhtamp_outrun = -1;
+    }
+}
+
+/* Push any staged RLE bytes into Tamp. */
+STATIC_OVL void
+nhtamp_stage_flush()

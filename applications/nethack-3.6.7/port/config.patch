+/* Monster identity/indexing stays in flash. Quest-dependent reads/writes
+ * use three small writable copies while all monster data pointers stay canonical. */
+#include "hack.h"
+struct nh_quest_traits {
+    const struct permonst *base;
+    struct permonst data;
+};
+static struct nh_quest_traits traits[3];
+void nh_quest_traits_init(int leader, int guardian, int nemesis)
+{
+    int ids[3], i;
+    ids[0] = leader; ids[1] = guardian; ids[2] = nemesis;
+    for (i = 0; i < 3; ++i) {
+        memset(&traits[i], 0, sizeof traits[i]);
+        if (ids[i] == NON_PM) continue;
+        if (ids[i] < LOW_PM || ids[i] >= NUMMONS)
+            panic("invalid quest monster");
+        traits[i].base = &mons[ids[i]];
+        traits[i].data = *traits[i].base;
+    }
+}
+struct permonst *nh_pm_traits(const struct permonst *pm)
+{
+    int i;
+    for (i = 0; i < 3; ++i)
+        if (traits[i].base && traits[i].base == pm) return &traits[i].data;
+    return (struct permonst *) pm;
+}
